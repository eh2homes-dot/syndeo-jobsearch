{
  "_how_to_edit": "Each source is one page (or a few). 'priority' decides which listing wins when two sources show the same event (1 = best). Set \"disabled\": true to switch a source off without deleting it.",
  "horizon_days": 183,
  "exclude_title_patterns": ["committee", "board of directors", "board meeting", "assembly of delegates",
                             "emerging leaders", "leadership symposium", "exhibitor summit", "^\\s*20\\d\\d calendar\\s*$"],
  "newsletter": {
    "weeks": 8,
    "max_per_source": {"bisnow": 6},
    "max_company_events": 10,
    "max_chapter_events": 6,
    "max_just_announced": 5
  },
  "sources": [
    {"id": "nrhc", "name": "NRHC", "group": "associations", "priority": 1, "parser": "date_title",
