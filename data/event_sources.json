     "index_url": "https://imn.org/",
     "events": [
       {"slug": "imn-sfr-west", "name": "IMN Single Family Rental West"},
       {"slug": "imn-sfr-east", "name": "IMN Single Family Rental East"},
       {"slug": "imn-sfr-pm", "name": "IMN SFR/BTR Property Management & Operations"},
