  "_apartment_associations_how_to": "NAA national is in 'sources' above. To add a state apartment association, add an entry here like {\"id\": \"taa\", \"name\": \"Texas Apartment Association\", \"group\": \"associations\", \"priority\": 3, \"parser\": \"generic\", \"url\": \"<their events calendar page>\"}. The generic reader tries structured event data, the WordPress events API, iCal links, then the page text.",
  "apartment_associations": [],

  "companies": {
    "_note": "Events hosted by companies in leads/master_leads.csv. Events pages live in data/events_map.json.",
    "recheck_none_after_days": 28,
    "max_detail_pages": 8,
    "hosted_markers": ["webinar", "happy hour", "reception", "dinner", "breakfast", "lunch", "party", "mixer", "meetup",
                       "meet-up", "workshop", "office hours", "user conference", "customer conference", "roadshow",
